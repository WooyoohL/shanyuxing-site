---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Hero from '@components/Hero.astro';
import Section from '@components/Section.astro';
import ServiceCard from '@components/ServiceCard.astro';
import ExampleCard from '@components/ExampleCard.astro';
import Contact from '@components/Contact.astro';
import Footer from '@components/Footer.astro';
import { services } from '@data/services';
import { examples } from '@data/examples';
import { audiences, collaborationPaths, deliveryAssurance, deliveryBoundaries } from '@data/home';
---

<BaseLayout>
  <Navbar />
  <main class="page-shell">
    <Hero />

    <Section
      id="audience"
      title="适合谁"
      subtitle="适合已经有客户项目、服务交付或明确业务场景的团队，从一个可验收的小模块开始合作。"
      tone="white"
    >
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {audiences.map((audience, index) => (
          <article class="surface-card h-full p-6 lg:p-7">
            <span class="text-sm font-semibold text-brand-600">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-5 max-w-sm text-xl font-medium leading-tight text-ink">{audience.title}</h3>
            <p class="mt-5 leading-8 text-muted">{audience.description}</p>
          </article>
        ))}
      </div>
    </Section>

    <Section
      id="examples"
      title="常见业务场景"
      subtitle="客户通常先从“我遇到什么问题”判断是否适合合作。以下场景适合从真实资料、明确输入和人工确认节点开始验证。"
      tone="white"
    >
      <div class="grid gap-5 md:grid-cols-2">
        {examples.map((example) => (
          <ExampleCard
            title={example.title}
            input={example.input}
            output={example.output}
            suitableFor={example.suitableFor}
            boundary={example.boundary}
          />
        ))}
      </div>
    </Section>

    <section
      id="services"
      class="snap-section section-pad relative overflow-hidden bg-[radial-gradient(circle_at_18%_4%,rgba(0,113,227,0.08),transparent_30rem)]"
    >
      <div class="section-inner grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
        <div class="fade-in lg:sticky lg:top-28">
          <p class="eyebrow mb-3">Module Delivery</p>
          <h2 class="max-w-xl text-3xl font-medium leading-tight text-ink sm:text-5xl">可交付模块</h2>
          <p class="mt-5 max-w-xl text-base leading-8 text-muted sm:text-lg">
            每个模块都围绕业务问题、典型输入、输出结果和适用场景设计，便于集成到现有产品或流程里。
          </p>
        </div>

        <div class="grid gap-4">
          {services.map((service, index) => (
            <ServiceCard title={service.title} description={service.description} index={index + 1} />
          ))}
        </div>
      </div>
    </section>

    <Section
      id="service-model"
      title="如何合作"
      subtitle="按你当前角色和项目阶段选择合作路径。重点是先把一个真实业务问题做成可用模块，再根据使用效果迭代。"
      tone="slate"
    >
      <div class="grid gap-5 lg:grid-cols-3">
        {collaborationPaths.map((path, index) => (
          <article class="surface-card h-full p-6 lg:p-7">
            <span class="text-sm font-semibold text-brand-600">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-5 text-2xl font-medium leading-tight text-ink">{path.title}</h3>
            <p class="mt-5 rounded-[20px] border border-brand-500/[0.14] bg-brand-50/[0.62] px-4 py-3 text-sm leading-6 text-brand-600">
              {path.suitableFor}
            </p>
            <p class="mt-5 leading-8 text-muted">{path.description}</p>
          </article>
        ))}
      </div>
    </Section>

    <section
      id="delivery"
      class="snap-section section-pad bg-canvas"
    >
      <div class="section-inner">
        <div class="fade-in mx-auto max-w-3xl text-center">
          <p class="eyebrow mb-3">Delivery Control</p>
          <h2 class="text-3xl font-medium leading-tight text-ink sm:text-5xl">如何保证模块可用</h2>
          <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-muted sm:text-lg">
            交付前先把输入、输出、人工确认、系统集成和验收标准说清楚，让项目可控、可检查、可迭代。
          </p>
        </div>

        <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-5">
          {deliveryAssurance.map((item, index) => (
            <article class="surface-card p-5">
              <span class="text-sm font-semibold text-brand-600">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 text-lg font-medium leading-tight text-ink">{item.title}</h3>
              <p class="mt-4 text-sm leading-7 text-muted">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Section
      id="boundaries"
      title="更适合从明确小场景开始，不适合一上来做大而全系统"
      subtitle="边界说清楚，项目才更容易落地。我们更关注可验收的小模块和真实工作流，而不是过度承诺。"
      tone="white"
    >
      <div class="surface-card subtle-glow mx-auto max-w-5xl overflow-hidden p-6 sm:p-8 lg:p-10">
        <div class="grid gap-4 md:grid-cols-2">
          {deliveryBoundaries.map((boundary) => (
            <div class="flex gap-3 rounded-[22px] border border-black/10 bg-white/[0.48] p-4 backdrop-blur-xl">
              <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-brand-500"></span>
              <p class="text-sm leading-7 text-muted sm:text-base">{boundary}</p>
            </div>
          ))}
        </div>
      </div>
    </Section>

    <Contact />
  </main>
  <Footer />
</BaseLayout>
