---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Hero from '@components/Hero.astro';
import Section from '@components/Section.astro';
import ServiceCard from '@components/ServiceCard.astro';
import ExampleCard from '@components/ExampleCard.astro';
import Contact from '@components/Contact.astro';
import Footer from '@components/Footer.astro';
import { services } from '@data/services';
import { capabilities } from '@data/capabilities';
import { examples } from '@data/examples';

const serviceSteps = [
  '项目协作',
  '功能模块开发',
  '小场景验证',
  '工作流集成',
  '维护与迭代',
];

const audiences = [
  {
    title: '软件公司 / 小程序公司 / 系统集成商',
    description:
      '适用于已有客户项目，需要补齐模型接入、文本处理、知识库问答或自动化流程经验的团队。',
  },
  {
    title: '电商代运营 / 企业服务商 / 培训咨询公司',
    description:
      '适用于客户已有客服、运营、数据整理或内容处理需求，需要将 AI 模块纳入交付方案的服务团队。',
  },
  {
    title: '有明确场景的中小企业',
    description:
      '适用于已明确重复、耗时或易出错环节，希望先以单个功能或半自动化流程验证效果的企业。',
  },
];
---

<BaseLayout>
  <Navbar />
  <main class="page-shell">
    <Hero />

    <Section
      id="audience"
      title="适合谁"
      subtitle="适合已有明确项目、客户需求或业务场景的团队，从可交付的小模块开始合作。"
      tone="white"
    >
      <div class="grid gap-5 lg:grid-cols-3">
        {audiences.map((audience, index) => (
          <article class="surface-card h-full p-6 lg:p-7">
            <span class="text-sm font-semibold text-brand-600">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-5 max-w-sm font-display text-xl font-semibold leading-[1.16] tracking-[-0.006em] text-ink">{audience.title}</h3>
            <p class="mt-5 font-sans text-[0.96rem] leading-[1.7] text-muted">{audience.description}</p>
          </article>
        ))}
      </div>
    </Section>

    <section
      id="services"
      class="snap-section section-pad relative overflow-hidden bg-[radial-gradient(circle_at_18%_4%,rgba(0,113,227,0.08),transparent_30rem)]"
    >
      <div class="section-inner grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
        <div class="fade-in lg:sticky lg:top-28">
          <p class="eyebrow mb-3">Module Delivery</p>
          <h2 class="max-w-xl font-display text-[2rem] font-semibold leading-[1.12] tracking-[-0.012em] text-ink sm:text-4xl">可交付模块</h2>
          <p class="mt-5 max-w-xl font-sans text-base leading-[1.7] text-muted sm:text-[1.05rem]">
            围绕明确业务环节，交付可开发、可集成、可验收的 AI 功能模块。
          </p>
        </div>

        <div class="grid gap-4">
          {services.map((service, index) => (
            <ServiceCard title={service.title} description={service.description} index={index + 1} />
          ))}
        </div>
      </div>
    </section>

    <Section
      id="examples"
      title="常见落地场景"
      subtitle="以下为常见可交付场景示例，用于说明适合从哪些小场景开始验证，不代表真实客户案例。"
      tone="white"
    >
      <div class="grid gap-5 md:grid-cols-2">
        {examples.map((example) => (
          <ExampleCard
            title={example.title}
            input={example.input}
            output={example.output}
            suitableFor={example.suitableFor}
            boundary={example.boundary}
          />
        ))}
      </div>
    </Section>

    <Section
      id="service-model"
      title="合作方式"
      subtitle="既可以作为软件公司或企业服务商的 AI 开发补位，也可以围绕单个明确场景做小步交付。"
      tone="slate"
    >
      <ol class="mx-auto grid max-w-5xl gap-4 md:grid-cols-5">
        {serviceSteps.map((step, index) => (
          <li class="surface-card p-5">
            <span class="text-sm font-semibold text-brand-600">{String(index + 1).padStart(2, '0')}</span>
            <p class="mt-3 font-display text-base font-semibold leading-[1.16] tracking-[-0.006em] text-ink">{step}</p>
          </li>
        ))}
      </ol>
      <p class="mx-auto mt-8 max-w-3xl text-center font-sans text-[0.96rem] leading-[1.7] text-muted">
        合作前先明确交付边界、数据来源、使用场景和人工确认节点，优先完成能被真实团队使用的小模块，再根据反馈维护与迭代。
      </p>
    </Section>

    <section
      id="capabilities"
      class="snap-section section-pad bg-canvas"
    >
      <div class="section-inner">
        <div class="fade-in mx-auto max-w-3xl text-center">
          <p class="eyebrow mb-3">Technical Support</p>
          <h2 class="font-display text-[2rem] font-semibold leading-[1.12] tracking-[-0.012em] text-ink sm:text-4xl">技术能力支撑</h2>
          <p class="mx-auto mt-5 max-w-2xl font-sans text-base leading-[1.7] text-muted sm:text-[1.05rem]">
            技术能力服务于交付结果。我们根据项目需要组合模型、数据处理、系统对接和维护能力。
          </p>
        </div>

        <div class="mx-auto mt-10 flex max-w-5xl flex-wrap justify-center gap-3">
          {capabilities.map((capability) => (
            <span class="rounded-full border border-black/10 bg-white/[0.56] px-4 py-2.5 font-sans text-sm font-medium leading-none text-ink shadow-sm backdrop-blur-xl">
              {capability.title}
            </span>
          ))}
        </div>
      </div>
    </section>

    <Contact />
  </main>
  <Footer />
</BaseLayout>
