---
interface Props {
  title: string;
  input: string;
  output: string;
  suitableFor: string;
  boundary: string;
}

const { title, input, output, suitableFor, boundary } = Astro.props;

const rows = [
  ['输入', input],
  ['输出', output],
  ['适合', suitableFor],
  ['边界', boundary],
];
---

<article class="surface-card flex h-full flex-col p-6 lg:p-7">
  <h3 class="text-2xl font-medium leading-tight text-ink">{title}</h3>
  <div class="mt-6 grid flex-1 gap-4">
    {rows.map(([label, value]) => (
      <div class="rounded-[20px] border border-black/10 bg-white/[0.46] p-4">
        <p class="text-xs font-semibold text-brand-600">{label}</p>
        <p class="mt-2 text-sm leading-6 text-muted">{value}</p>
      </div>
    ))}
  </div>
</article>
