---
interface Props {
  title: string;
  input: string;
  output: string;
  suitableFor: string;
  boundary: string;
}

const { title, input, output, suitableFor, boundary } = Astro.props;

const rows = [
  ['输入', input],
  ['输出', output],
  ['适合', suitableFor],
  ['边界', boundary],
];
---

<article class="surface-card flex h-full flex-col p-6">
  <h3 class="text-xl font-medium text-ink">{title}</h3>
  <div class="mt-5 grid flex-1 gap-4">
    {rows.map(([label, value]) => (
      <div class="border-t border-slate-100 pt-4">
        <p class="text-sm font-semibold text-brand-600">{label}</p>
        <p class="mt-2 text-sm leading-6 text-slate-700">{value}</p>
      </div>
    ))}
  </div>
</article>
