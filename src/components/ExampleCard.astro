---
interface Props {
  title: string;
  content: string;
  suitableFor: string;
}

const { title, content, suitableFor } = Astro.props;
---

<article class="surface-card flex h-full flex-col p-6">
  <h3 class="text-xl font-medium text-ink">{title}</h3>
  <p class="mt-4 flex-1 leading-7 text-slate-600">{content}</p>
  <div class="mt-6 rounded-2xl border border-slate-100 bg-slate-50/80 p-4">
    <p class="text-sm font-semibold text-slate-500">适合</p>
    <p class="mt-2 text-sm leading-6 text-slate-700">{suitableFor}</p>
  </div>
</article>
