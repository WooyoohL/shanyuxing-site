---
interface Props {
  title: string;
  description: string;
  index: number;
}

const { title, description, index } = Astro.props;
---

<article class="surface-card group grid gap-5 p-6 sm:grid-cols-[3.5rem_1fr] lg:p-7">
  <div class="flex h-12 w-12 items-center justify-center rounded-full border border-brand-500/[0.15] bg-brand-50 text-sm font-semibold text-brand-600 transition-all duration-200 group-hover:bg-brand-500 group-hover:text-white">
    {String(index).padStart(2, '0')}
  </div>
  <div>
    <h3 class="font-display text-xl font-semibold leading-[1.16] tracking-[-0.006em] text-ink">{title}</h3>
    <p class="mt-3 max-w-2xl font-sans text-[0.96rem] font-normal leading-[1.7] text-muted">{description}</p>
  </div>
</article>
