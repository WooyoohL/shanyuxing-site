---
interface Props {
  title: string;
  description: string;
  index: number;
}

const { title, description, index } = Astro.props;
---

<article class="surface-card group h-full p-6 lg:p-7">
  <div class="mb-6 flex h-11 w-11 items-center justify-center rounded-full bg-brand-50 text-sm font-semibold text-brand-600 ring-1 ring-brand-100 transition-all duration-200 group-hover:bg-brand-600 group-hover:text-white">
    {String(index).padStart(2, '0')}
  </div>
  <h3 class="text-xl font-medium text-ink">{title}</h3>
  <p class="mt-4 leading-8 text-slate-600">{description}</p>
</article>
