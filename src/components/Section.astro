---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  eyebrow?: string;
  tone?: 'white' | 'blue' | 'slate';
}

const { id, title, subtitle, eyebrow, tone = 'white' } = Astro.props;

const toneClass = {
  white: 'bg-canvas',
  blue: 'bg-[radial-gradient(circle_at_18%_0%,rgba(0,113,227,0.08),transparent_30rem)]',
  slate: 'bg-canvas',
}[tone];
---

<section id={id} class:list={['snap-section section-pad relative overflow-hidden', toneClass]}>
  <div class="section-inner">
    <div class="fade-in mx-auto max-w-3xl text-center">
      {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
      <h2 class="text-[2rem] font-medium leading-tight tracking-normal text-ink sm:text-4xl">{title}</h2>
      {subtitle && <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-muted sm:text-[1.05rem]">{subtitle}</p>}
    </div>
    <div class="mt-12">
      <slot />
    </div>
  </div>
</section>
