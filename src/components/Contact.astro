---
const fields = [
  '公司/团队类型与行业',
  '当前业务问题是什么',
  '现在如何人工处理',
  '已有资料或系统',
  '希望 AI 输出什么结果',
  '预算范围或上线时间要求',
];

const surveyUrl = 'https://wj.qq.com/s2/26770365/efb5/';
const wechatSupportUrl = 'https://work.weixin.qq.com/kfid/kfc3ba5c4dec1252ef0';
const contactEmail = 'contact@shanyuxing-ai.com';
---

<section id="contact" class="snap-section section-pad bg-canvas">
  <div class="section-inner">
    <div class="surface-card subtle-glow fade-in overflow-hidden p-6 sm:p-8 lg:p-10">
      <div class="grid items-start gap-10 lg:grid-cols-[0.95fr_1.05fr]">
        <div>
          <p class="eyebrow mb-3">联系合作</p>
          <h2 class="max-w-2xl text-3xl font-medium leading-tight tracking-normal text-ink sm:text-5xl">从一个业务问题开始沟通</h2>
          <p class="mt-5 max-w-2xl text-base leading-8 text-muted sm:text-lg">
            你可以通过业务场景表单、企业邮箱或企业微信联系。建议先说明当前业务问题、人工处理方式、已有资料或系统，以及希望 AI 输出什么结果。
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              class="pill-button pill-primary"
              href={surveyUrl}
              target="_blank"
              rel="noreferrer"
            >
              填写业务问题表单
            </a>
            <a
              class="pill-button pill-secondary"
              href={wechatSupportUrl}
              target="_blank"
              rel="noreferrer"
            >
              咨询项目协作
            </a>
          </div>
          <button
            class="mt-5 inline-flex rounded-full text-sm font-medium text-muted transition-colors hover:text-brand-600"
            type="button"
            data-copy-email={contactEmail}
            aria-label={`复制邮箱地址 ${contactEmail}`}
          >
            企业邮箱：{contactEmail}
          </button>
        </div>

        <div class="grid gap-4 md:grid-cols-[1fr_0.82fr]">
          <div class="rounded-[24px] border border-black/10 bg-white/[0.46] p-5 backdrop-blur-xl">
            <h3 class="text-lg font-medium text-ink">合作前请尽量说明</h3>
            <div class="mt-5 grid gap-2 sm:grid-cols-2">
              {fields.map((field) => (
                <span
                  class:list={[
                    'flex min-h-11 items-center justify-center rounded-full border border-black/10 bg-white/[0.58] px-3 py-2 text-center text-sm leading-5 text-muted shadow-sm',
                    field.length >= 8 && 'sm:col-span-2',
                  ]}
                >
                  {field}
                </span>
              ))}
            </div>
          </div>

          <div class="rounded-[24px] border border-brand-500/[0.14] bg-brand-50/[0.58] p-5 text-center backdrop-blur-xl">
            <a
              class="mx-auto block max-w-44 overflow-hidden rounded-[22px] bg-white p-2 shadow-sm ring-1 ring-black/10 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md"
              href={wechatSupportUrl}
              target="_blank"
              rel="noreferrer"
              aria-label="打开微信客服"
            >
              <img
                src={`${import.meta.env.BASE_URL}wechat-qr.png`}
                alt="微信 / 企业微信二维码"
                class="h-auto w-full rounded-[16px]"
                loading="lazy"
              />
            </a>
            <p class="mt-4 text-sm leading-6 text-muted">
              扫码咨询项目协作，或直接打开微信客服
            </p>
            <a
              class="mt-4 inline-flex min-h-10 items-center justify-center rounded-full border border-brand-500/[0.16] bg-white/[0.72] px-4 py-2 text-sm font-medium text-brand-600 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-500/[0.24] hover:bg-white hover:shadow-md active:translate-y-0 active:scale-[0.98]"
              href={wechatSupportUrl}
              target="_blank"
              rel="noreferrer"
            >
              打开微信客服
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none fixed left-1/2 top-1/2 z-[60] -translate-x-1/2 -translate-y-1/2 scale-95 rounded-full border border-black/10 bg-white/[0.86] px-4 py-2 text-sm font-semibold text-brand-600 opacity-0 shadow-float backdrop-blur-xl transition-all duration-200"
    role="status"
    aria-live="polite"
    data-copy-toast
  >
    已复制地址
  </div>
</section>

<script>
  const copyButton = document.querySelector('[data-copy-email]');
  const copyToast = document.querySelector('[data-copy-toast]');
  let toastTimer;

  const showCopyToast = () => {
    copyToast?.classList.remove('scale-95', 'opacity-0');
    copyToast?.classList.add('scale-100', 'opacity-100');

    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      copyToast?.classList.add('scale-95', 'opacity-0');
      copyToast?.classList.remove('scale-100', 'opacity-100');
    }, 1800);
  };

  const fallbackCopy = (text) => {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand('copy');
    textarea.remove();
  };

  copyButton?.addEventListener('click', async () => {
    const email = copyButton.getAttribute('data-copy-email');

    if (!email) {
      return;
    }

    try {
      await navigator.clipboard.writeText(email);
    } catch {
      fallbackCopy(email);
    }

    showCopyToast();
  });
</script>
