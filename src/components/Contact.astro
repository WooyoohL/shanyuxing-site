---
const wechatSupportUrl = 'https://work.weixin.qq.com/kfid/kfc3ba5c4dec1252ef0';
const contactEmail = 'contact@shanyuxing-ai.com';
---

<section id="contact" class="snap-section section-pad bg-canvas">
  <div class="section-inner">
    <div class="surface-card subtle-glow fade-in overflow-hidden p-6 sm:p-8 lg:p-10">
      <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="eyebrow mb-3">联系合作</p>
          <h2 class="max-w-2xl font-display text-3xl font-semibold leading-[1.12] tracking-[-0.012em] text-ink sm:text-4xl">从项目协作或具体场景开始</h2>
          <p class="mt-5 max-w-2xl font-sans text-base leading-[1.7] text-muted sm:text-[1.05rem]">
            如果已有客户项目或明确业务场景，可以通过企业微信客服或企业邮箱沟通。我们会先确认场景、资料、输出结果与交付边界，再判断适合的协作方式。
          </p>
          <button
            class="mt-7 inline-flex min-h-11 items-center rounded-full border border-black/10 bg-white/[0.58] px-4 py-2.5 font-sans text-sm font-medium text-muted shadow-sm backdrop-blur-xl transition-colors hover:text-brand-600"
            type="button"
            data-copy-email={contactEmail}
            aria-label={`复制邮箱地址 ${contactEmail}`}
          >
            企业邮箱：{contactEmail}
          </button>
        </div>

        <div class="rounded-[26px] border border-brand-500/[0.14] bg-brand-50/[0.46] p-5 text-center backdrop-blur-xl sm:p-6">
          <div class="mx-auto max-w-xs">
            <p class="font-display text-sm font-semibold text-brand-600">企业微信咨询</p>
            <p class="mt-2 font-sans text-sm leading-[1.65] text-muted">扫码或打开链接，沟通项目协作与场景需求。</p>
            <div
              class="mx-auto mt-5 block max-w-44 overflow-hidden rounded-[22px] bg-white p-2 shadow-sm ring-1 ring-black/10"
              aria-label="微信 / 企业微信二维码"
            >
              <img
                src={`${import.meta.env.BASE_URL}wechat-qr.png`}
                alt="微信 / 企业微信二维码"
                class="h-auto w-full rounded-[16px]"
                loading="lazy"
              />
            </div>
            <a
              class="mt-4 inline-flex min-h-10 items-center justify-center rounded-full border border-brand-500/[0.16] bg-white/[0.72] px-4 py-2 text-sm font-medium text-brand-600 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-500/[0.24] hover:bg-white hover:shadow-md active:translate-y-0 active:scale-[0.98]"
              href={wechatSupportUrl}
              target="_blank"
              rel="noreferrer"
            >
              打开微信客服
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none fixed left-1/2 top-1/2 z-[60] -translate-x-1/2 -translate-y-1/2 scale-95 rounded-full border border-black/10 bg-white/[0.86] px-4 py-2 text-sm font-semibold text-brand-600 opacity-0 shadow-float backdrop-blur-xl transition-all duration-200"
    role="status"
    aria-live="polite"
    data-copy-toast
  >
    已复制地址
  </div>
</section>

<script>
  const copyButton = document.querySelector('[data-copy-email]');
  const copyToast = document.querySelector('[data-copy-toast]');
  let toastTimer;

  const showCopyToast = () => {
    copyToast?.classList.remove('scale-95', 'opacity-0');
    copyToast?.classList.add('scale-100', 'opacity-100');

    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      copyToast?.classList.add('scale-95', 'opacity-0');
      copyToast?.classList.remove('scale-100', 'opacity-100');
    }, 1800);
  };

  const fallbackCopy = (text) => {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand('copy');
    textarea.remove();
  };

  copyButton?.addEventListener('click', async () => {
    const email = copyButton.getAttribute('data-copy-email');

    if (!email) {
      return;
    }

    try {
      await navigator.clipboard.writeText(email);
    } catch {
      fallbackCopy(email);
    }

    showCopyToast();
  });
</script>
